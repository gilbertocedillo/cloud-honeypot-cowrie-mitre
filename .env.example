# Copy to .env - NEVER commit the real .env
# Honeypot / Terraform
WEBHOOK_URL=https://your-n8n-instance/webhook/honeypot-session
ALLOWED_ADMIN_CIDR=203.0.113.10/32

# n8n environment variables
VIRUSTOTAL_API_KEY=your_virustotal_api_key
OPENAI_API_KEY=your_openai_api_key
# Alternative LLM: ANTHROPIC_API_KEY= / OLLAMA_URL=http://localhost:11434
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Block Lambda (from terraform outputs)
AWS_REGION=us-east-1
NACL_ID=acl-xxxxxxxxxxxxxxxxx
WAF_IPSET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WAF_IPSET_NAME=honeypot-lab-blocklist
BLOCK_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:honeypot-lab-block-ip
DRY_RUN=true
MAX_BLOCKED_IPS=900
